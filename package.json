{
  "name": "emach",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.1",
      "zod": "^4.3.6",
      "lucide-react": "^0.546.0",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "better-auth": "1.6.11",
      "@types/node": "^22.19.19",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "resend": "^6.12.2",
      "@react-email/components": "^1.0.12",
      "@react-email/render": "^2.0.7"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @emach/db db:push",
    "db:studio": "turbo -F @emach/db db:studio",
    "db:generate": "echo 'LEGACY: schema sync e via CI PR do dashboard. Em dev use db:push.' && exit 1",
    "db:migrate": "echo 'LEGACY: pasta migrations/ removida. Use db:push + db:apply-triggers.' && exit 1",
    "check": "ultracite check",
    "check:env": "bun scripts/check-vercel-env.ts",
    "fix": "ultracite fix",
    "clean": "bash scripts/clean.sh",
    "clean-all": "bash scripts/clean.sh -y --cache",
    "clean-dry": "bash scripts/clean.sh --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@emach/config": "workspace:*",
    "@types/node": "catalog:",
    "d3-geo": "^3.1.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0"
  },
  "packageManager": "bun@1.3.11"
}
