{
  "name": "@emach/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "echo 'LEGACY: schema sync e via CI PR do dashboard. Em dev use db:push.' && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "echo 'LEGACY: pasta migrations/ removida. Use db:push + db:apply-triggers.' && exit 1",
    "db:apply-triggers": "bun run scripts/apply-triggers.ts",
    "db:seed-categories": "bun run scripts/seed-categories.ts",
    "db:seed-attributes": "bun run scripts/seed-attributes.ts",
    "db:anonymize-client": "bun run scripts/anonymize-client.ts",
    "db:check-drift": "bun run scripts/check-schema-drift.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase:start": "supabase start --workdir .",
    "test:supabase:stop": "supabase stop --workdir .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@emach/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@emach/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6",
    "vitest": "^2.1.8"
  }
}
